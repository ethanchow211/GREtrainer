{
  "name": "gre-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local GRE trainer. Questions generated by Claude via the Claude Code subscription, verified before use.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "smoke": "node scripts/smoke.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "review": "node scripts/review.ts",
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "snapshot": "node scripts/snapshot.ts",
    "restore": "node scripts/snapshot.ts restore",
    "reset-progress": "node scripts/reset-progress.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "express": "^5.2.1",
    "katex": "^0.16.47",
    "marked": "^15.0.12"
  }
}

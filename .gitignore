node_modules/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
.env
.env.*
!.env.example
dist/
*.log
.playwright-mcp/

# The JSON snapshot IS committed -- it is how progress moves between machines.
!data/snapshot/
data/*.before-reset

# Printed worksheets are generated from the bank on demand; the order that matters
# lives in the database, not in the HTML.
data/worksheet.html

# Backup copies made before edits (code and the progress database). They stay on
# this Mac; they should never be published.
*.bak.*
data/*.db.bak*

# GRE Trainer configuration. Copy to .env and edit. Nothing here is a secret --
# the app authenticates by running the `claude` command, which uses the
# subscription credentials already on this machine. There is no API key.

# Hard ceiling on Claude calls per day. Generating one usable question costs
# roughly 2-3 calls (write it, then verify it independently). The app refuses to
# generate once this is hit, so a runaway loop cannot burn your subscription
# quota. Start conservative, raise it once you have seen real usage in `/status`.
GRE_MAX_CALLS_PER_DAY=150

# Model used for generating and verifying questions. Sonnet is the right default:
# far cheaper against your quota than Opus and entirely good enough here.
GRE_MODEL=sonnet

# How many ready, verified, unseen questions to keep stocked per topic bucket.
# Higher means you never wait; lower means less generated ahead of what you use.
GRE_BUFFER_DEPTH=5

# Seconds before a single Claude call is considered hung and killed.
GRE_CALL_TIMEOUT_SEC=120

# Port the local server listens on.
GRE_PORT=5174
